---
import colorsData from '../../colors.json';

interface Props {
  color: string;
  label: string;
  sublabel: string;
}

const { color, label, sublabel } = Astro.props;
---

<div class="flex flex-col items-center rounded-lg p-2">
  <div
    class={`w-16 h-16 rounded-md mb-3 border border-accent/30`}
    style={`background: ${color}`}
  ></div>
  <div class="text-sm font-medium text-center text-content mb-1 whitespace-nowrap">{label}</div>
  <div class="text-xs text-center text-content-subtle whitespace-nowrap">{sublabel}</div>
</div>
