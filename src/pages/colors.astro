---
import "../styles/global.css";
import SemanticColorCard from "../components/SemanticColorCard.astro";
import colorsData from "../../colors.json";

const { primary, secondary, muted, semantic } = colorsData;

// Filter colors to only show up to 900
const filterColors = (colors: Record<string, string>) =>
  Object.fromEntries(
    Object.entries(colors).filter(([key]) => parseInt(key) <= 900)
  );

const colorScales = [
  { name: "Primary", colors: filterColors(primary) },
  { name: "Secondary", colors: filterColors(secondary) },
  { name: "Muted", colors: filterColors(muted) },
];

const colorSteps = [
  "900",
  "800",
  "700",
  "600",
  "500",
  "400",
  "300",
  "200",
  "100",
  "50",
];

const semanticColors = [
  // Content colors
  { color: primary["100"], label: "content", sublabel: "primary-100" },
  { color: muted["500"], label: "content-subtle", sublabel: "muted-500" },

  // Background colors (dark to light)
  { color: muted["950"], label: "bg-dark", sublabel: "muted-950" },
  { color: muted["900"], label: "bg", sublabel: "muted-900" },
  { color: muted["800"], label: "bg-light", sublabel: "muted-800" },

  // Semantic brand colors
  { color: primary["400"], label: "primary", sublabel: "primary-400" },
  { color: secondary["700"], label: "secondary", sublabel: "secondary-700" },
  { color: secondary["500"], label: "accent", sublabel: "secondary-500" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Color Palette</title>
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-12 flex flex-col items-center">
      <h1 class="text-3xl font-bold mb-12 text-center">Color Palette</h1>
      <!-- Color Scale Table -->
      <div class="max-w-[800px]">
        <!-- Column headers -->
        <div class="grid grid-cols-10 gap-3 mb-3">
          {
            colorSteps.map((step) => (
              <div class="text-xs font-medium text-content text-center">
                {step}
              </div>
            ))
          }
        </div>

        <!-- Color rows -->
        {
          colorScales.map(({ name, colors }) => (
            <div class="grid grid-cols-10 gap-3 mb-3">
              {colorSteps.map((step) => (
                <div
                  class="aspect-square rounded-lg flex items-center justify-center border border-accent/30"
                  style={`background: ${colors[step]}`}
                >
                  {step === "500" && (
                    <span class="text-xs font-semibold text-content">
                      {name}
                    </span>
                  )}
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <!-- Semantic Colors -->
      <div class="max-w-[800px]">
        <h2 class="text-xl font-semibold mb-8 text-center">Semantic Colors</h2>
        <div class="flex flex-wrap gap-4 justify-center">
          {
            semanticColors.map(({ color, label, sublabel }) => (
              <SemanticColorCard
                color={color}
                label={label}
                sublabel={sublabel}
              />
            ))
          }
        </div>
      </div>

      <!-- Test Elements -->
      <div class="mt-16 mb-12">
        <h2 class="text-xl font-semibold mb-8">Test Elements</h2>

        <div
          class="rounded-lg p-6 mb-6 max-w-4xl mx-auto"
          style={`background: ${semantic["bg-dark"]}`}
        >
          <p class="text-xs mb-4 opacity-50">bg-dark (muted-950)</p>

          <div class="rounded-lg p-6 mb-4" style={`background: ${semantic.bg}`}>
            <p class="text-xs mb-4 opacity-50">bg (muted-900)</p>
            <h3 class="text-2xl font-bold mb-3">Dashboard Overview</h3>
            <p class="text-base mb-6 text-content-subtle">
              Muted text using muted-500
            </p>

            <div
              class="rounded-lg p-5 mb-4"
              style={`background: ${semantic["bg-light"]}; border: 1px solid ${semantic.accent}`}
            >
              <p class="text-xs mb-3 opacity-50">bg-light (muted-800)</p>
              <h4 class="text-lg font-semibold mb-3">Active Component</h4>
              <p class="text-sm mb-4 opacity-80">
                This is a div with layered surfaces and accent border.
              </p>

              <div class="flex gap-3 flex-wrap">
                <button
                  class="px-4 py-2 rounded-md text-sm font-medium transition-opacity hover:opacity-90"
                  style={`background: ${semantic.primary}; color: ${semantic["bg-dark"]}`}
                >
                  Primary Action
                </button>
                <button
                  class="px-4 py-2 rounded-md text-sm font-medium transition-opacity hover:opacity-90 bg-secondary text-content"
                >
                  Secondary
                </button>
                <button
                  class="px-4 py-2 rounded-md text-sm font-medium transition-opacity hover:opacity-90"
                  style={`background: transparent; border: 1px solid ${semantic.accent}; color: ${semantic.accent}`}
                >
                  Accent
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div
                class="rounded-lg p-4"
                style={`background: ${semantic["bg-light"]}`}
              >
                <p class="text-sm mb-1 text-content-subtle">Users</p>
                <p
                  class="text-3xl font-bold"
                  style={`color: ${semantic.primary}`}
                >
                  1,234
                </p>
              </div>
              <div
                class="rounded-lg p-4"
                style={`background: ${semantic["bg-light"]}`}
              >
                <p class="text-sm mb-1 text-content-subtle">Revenue</p>
                <p
                  class="text-3xl font-bold"
                  style={`color: ${semantic.accent}`}
                >
                  $45.6k
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
